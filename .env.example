# Server Configuration
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sayina
DB_USER=postgres
DB_PASSWORD=postgres_password
DB_SSL=false

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_EXPIRY=1d
JWT_REFRESH_EXPIRY=7d

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password
EMAIL_FROM=Sayina <your_email@gmail.com>

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# BulkSMS Configuration
BULKSMS_API_URL=https://api.bulksms.com/v1
BULKSMS_USERNAME=your_bulksms_username
BULKSMS_API_KEY=your_bulksms_api_key
BULKSMS_FROM=Sayina

# PayFast Configuration
PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_MERCHANT_KEY=your_merchant_key
PAYFAST_PASSPHRASE=your_passphrase
PAYFAST_API_URL=https://api.payfast.co.za
PAYFAST_SANDBOX=true

# Storage Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760 # 10MB in bytes

# Security Configuration
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX=100 # 100 requests per window

# Logging Configuration
LOG_LEVEL=debug
LOG_FORMAT=dev

# Default Admin User (for seeding)
ADMIN_EMAIL=admin@sayina.co.za
ADMIN_PASSWORD=StrongPassword123!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
